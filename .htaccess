# SUPER DUPER CORP — Apache / LiteSpeed config (cPanel)
Options -Indexes
DirectoryIndex index.php index.html
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Hard-block internal folders (works on LiteSpeed too, which may ignore per-folder deny rules)
  RewriteRule ^(data|inc|tools)(/|$) - [F,L]
  RewriteRule ^admin/_ - [F,L]
  RewriteRule ^(README\.md|deploy\.sh|dev-router\.php|\.git) - [F,L]
  # Let the uploader key reach PHP on hosts that strip the Authorization header
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  # Force HTTPS (uncomment once SSL is active in cPanel, which it usually is via AutoSSL)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteRule ^work/?$ work.php [L,QSA]
  RewriteRule ^work/([A-Za-z0-9-]+)/?$ project.php?slug=$1 [L,QSA]
  RewriteRule ^(about|contact)/?$ $1.php [L,QSA]
  RewriteRule ^studio/?$ about.php [L,QSA]
</IfModule>

# Never serve internals. Kept narrow on purpose: this file also sits above any client
# sites stored in sub-folders of public_html, so it must not change how they behave.
# (data/, tools/ and admin/ include files are protected by their own .htaccess files.)
<FilesMatch "^(README\.md|dev-router\.php|\.git.*|\.env.*)$">
  <IfModule mod_authz_core.c>Require all denied</IfModule>
  <IfModule !mod_authz_core.c>Order allow,deny
  Deny from all</IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
